# Copia este archivo como .env y rellénalo con los datos de tu proyecto de Supabase
# (Project Settings > API). La clave anon es pública: está protegida por la seguridad por filas.
# Sin estos datos la app arranca en MODO DEMOSTRACIÓN (todo simulado).
VITE_SUPABASE_URL=https://TU_REF.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY
# Motor web de Godot para "Jugar ya" (súbelo una vez con fabrica/subir_motor.py):
VITE_MOTOR_URL=https://TU_REF.supabase.co/storage/v1/object/public/motor/godot/4.6.3
# Opcional: partidas de muestra en otro sitio que el motor (por defecto, junto al motor)
VITE_MUESTRAS_URL=https://TU_REF.supabase.co/storage/v1/object/public/motor/muestras
