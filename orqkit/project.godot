; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[admob]

general/ios/enabled=false

[application]

config/name="OrqKit"
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.png"

[autoload]

QA="*res://kit/qa.gd"
Kit="*res://kit/kit.gd"
Save="*res://kit/save.gd"
Juice="*res://kit/juice.gd"
Audio="*res://kit/audio.gd"
Ads="*res://kit/ads.gd"
UI="*res://kit/ui/ui.gd"
Telemetry="*res://kit/telemetry.gd"
Mods="*res://kit/mods.gd"
Online="*res://kit/online.gd"
Story="*res://kit/story.gd"
Look="*res://kit/look.gd"
Season="*res://kit/season.gd"
Store="*res://kit/store.gd"
Notify="*res://kit/notify.gd"
Twist="*res://kit/twist.gd"
Feats="*res://kit/feats.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/admob/plugin.cfg")

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
