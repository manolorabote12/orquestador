{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orquestador/guion/v1",
	"title": "Guion de clips para redes",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"variantes",
		"publicacion"
	],
	"properties": {
		"variantes": {
			"type": "array",
			"minItems": 3,
			"maxItems": 3,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"estilo",
					"gancho",
					"voz",
					"subtitulos",
					"cta"
				],
				"properties": {
					"estilo": {
						"enum": [
							"reto",
							"curiosidad",
							"humor"
						],
						"description": "reto: desafia al que mira. curiosidad: plantea algo que solo se resuelve viendo. humor: situacion graciosa del juego."
					},
					"gancho": {
						"type": "string",
						"minLength": 6,
						"maxLength": 42,
						"description": "Frase enorme de los 2-3 primeros segundos. Corta, directa, sin emojis."
					},
					"voz": {
						"type": "string",
						"minLength": 20,
						"maxLength": 200,
						"description": "Lo que dice la voz en off en 12 segundos (unas 25-32 palabras). Natural, en segunda persona, sin hashtags ni emojis."
					},
					"subtitulos": {
						"type": "array",
						"minItems": 3,
						"maxItems": 7,
						"items": {
							"type": "object",
							"additionalProperties": false,
							"required": [
								"desde",
								"hasta",
								"texto"
							],
							"properties": {
								"desde": {
									"type": "number",
									"minimum": 0,
									"maximum": 12.5
								},
								"hasta": {
									"type": "number",
									"minimum": 0.5,
									"maximum": 12.5
								},
								"texto": {
									"type": "string",
									"minLength": 2,
									"maxLength": 38
								}
							}
						},
						"description": "Frases en pantalla con su tiempo (segundos 0 a 12.5; los 2.5 ultimos son el cartel final). Siguen a la voz."
					},
					"cta": {
						"type": "string",
						"minLength": 4,
						"maxLength": 30,
						"description": "Llamada del cartel final (p. ej. 'Juega gratis en Google Play')."
					}
				}
			},
			"description": "Exactamente 3: una de cada estilo (reto, curiosidad, humor)."
		},
		"publicacion": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"es",
				"en"
			],
			"properties": {
				"es": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"titulo",
						"texto",
						"hashtags"
					],
					"properties": {
						"titulo": {
							"type": "string",
							"minLength": 5,
							"maxLength": 80,
							"description": "Titulo corto (YouTube Shorts lo usa tal cual)."
						},
						"texto": {
							"type": "string",
							"minLength": 20,
							"maxLength": 220,
							"description": "Texto de la publicacion (TikTok, Reels, descripcion de Shorts). Sin hashtags."
						},
						"hashtags": {
							"type": "array",
							"minItems": 3,
							"maxItems": 8,
							"items": {
								"type": "string",
								"pattern": "^#[A-Za-z0-9_À-ſ]{2,30}$"
							}
						}
					}
				},
				"en": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"titulo",
						"texto",
						"hashtags"
					],
					"properties": {
						"titulo": {
							"type": "string",
							"minLength": 5,
							"maxLength": 80,
							"description": "Titulo corto (YouTube Shorts lo usa tal cual)."
						},
						"texto": {
							"type": "string",
							"minLength": 20,
							"maxLength": 220,
							"description": "Texto de la publicacion (TikTok, Reels, descripcion de Shorts). Sin hashtags."
						},
						"hashtags": {
							"type": "array",
							"minItems": 3,
							"maxItems": 8,
							"items": {
								"type": "string",
								"pattern": "^#[A-Za-z0-9_À-ſ]{2,30}$"
							}
						}
					}
				}
			}
		}
	}
}
