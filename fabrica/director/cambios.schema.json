{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orquestador/cambio/v1",
	"title": "Plan de cambio sobre un juego ya fabricado",
	"description": "La IA traduce una instruccion a operaciones de una lista cerrada. El coste lo calcula el codigo.",
	"type": "object",
	"required": [
		"resumen",
		"operaciones"
	],
	"additionalProperties": false,
	"properties": {
		"resumen": {
			"type": "string",
			"minLength": 4,
			"maxLength": 260,
			"description": "Lo que va a cambiar, dicho por Chispa en espanol, en primera persona y breve."
		},
		"pregunta": {
			"type": "string",
			"maxLength": 200,
			"description": "Solo si la instruccion es imposible de interpretar: una pregunta corta. Entonces operaciones va vacia."
		},
		"no_puedo": {
			"type": "string",
			"maxLength": 240,
			"description": "Parte de la peticion que el taller aun no sabe hacer, explicada en una frase."
		},
		"operaciones": {
			"type": "array",
			"maxItems": 6,
			"items": {
				"type": "object",
				"required": [
					"op"
				],
				"additionalProperties": false,
				"properties": {
					"op": {
						"enum": [
							"textos",
							"ajustes",
							"redibujar",
							"paleta",
							"estilo",
							"anadir_enemigo",
							"quitar_enemigo",
							"anadir_nivel",
							"quitar_nivel",
							"rehacer_nivel",
							"poderes",
							"disparo",
							"jefe",
							"musica",
							"extras",
							"genero",
							"vista",
							"historia",
							"mapa",
							"preguntas",
							"funciones",
							"prueba_ab",
							"giros",
							"idiomas"
						]
					},
					"titulo": {
						"type": "string",
						"minLength": 2,
						"maxLength": 28
					},
					"lema": {
						"type": "string",
						"minLength": 4,
						"maxLength": 48
					},
					"heroe_nombre": {
						"type": "string",
						"minLength": 2,
						"maxLength": 24
					},
					"coleccionable_plural": {
						"type": "string",
						"minLength": 2,
						"maxLength": 20
					},
					"nombres_niveles": {
						"type": "array",
						"items": {
							"type": "object",
							"required": [
								"indice",
								"nombre"
							],
							"additionalProperties": false,
							"properties": {
								"indice": {
									"type": "integer",
									"minimum": 0
								},
								"nombre": {
									"type": "string",
									"minLength": 2,
									"maxLength": 28
								}
							}
						}
					},
					"sensacion": {
						"enum": [
							"agil",
							"normal",
							"pesada"
						]
					},
					"dificultad": {
						"enum": [
							"facil",
							"normal",
							"dificil"
						]
					},
					"vidas": {
						"type": "integer",
						"minimum": 1,
						"maximum": 6
					},
					"velocidad_enemigos": {
						"type": "object",
						"additionalProperties": false,
						"properties": {
							"walker": {
								"type": "number",
								"minimum": 0.4,
								"maximum": 1.8
							},
							"spiky": {
								"type": "number",
								"minimum": 0.4,
								"maximum": 1.8
							},
							"flyer": {
								"type": "number",
								"minimum": 0.4,
								"maximum": 1.8
							}
						}
					},
					"que": {
						"enum": [
							"heroe",
							"enemigo_walker",
							"enemigo_spiky",
							"enemigo_flyer",
							"moneda",
							"suelo",
							"jefe"
						]
					},
					"descripcion": {
						"type": "string",
						"minLength": 8,
						"maxLength": 240,
						"description": "En INGLES, descripcion visual completa y fija."
					},
					"paleta": {
						"type": "array",
						"minItems": 8,
						"maxItems": 16,
						"items": {
							"type": "string",
							"pattern": "^#[0-9a-fA-F]{6}$"
						}
					},
					"familia": {
						"enum": [
							"pixel_art",
							"cartoon",
							"low_poly",
							"realista",
							"pintado"
						]
					},
					"tipo": {
						"enum": [
							"walker",
							"spiky",
							"flyer"
						]
					},
					"nombre": {
						"type": "string",
						"minLength": 2,
						"maxLength": 28
					},
					"despues_de": {
						"type": "integer",
						"minimum": -1
					},
					"indice": {
						"type": "integer",
						"minimum": 0
					},
					"hacia": {
						"enum": [
							"mas_facil",
							"mas_dificil",
							"distinto"
						]
					},
					"activar": {
						"type": "array",
						"maxItems": 5,
						"items": {
							"enum": [
								"corazon",
								"doble_salto",
								"iman",
								"velocidad",
								"estrella"
							]
						}
					},
					"desactivar": {
						"type": "array",
						"maxItems": 5,
						"items": {
							"enum": [
								"corazon",
								"doble_salto",
								"iman",
								"velocidad",
								"estrella"
							]
						}
					},
					"activo": {
						"type": "boolean"
					},
					"ambiente": {
						"type": "string",
						"minLength": 4,
						"maxLength": 160,
						"description": "En INGLES: estado de animo de la musica."
					},
					"tempo": {
						"type": "integer",
						"minimum": 60,
						"maximum": 180
					},
					"puntos_control": {
						"type": "boolean"
					},
					"plataformas_moviles": {
						"type": "boolean"
					},
					"genero": {
						"enum": [
							"plataformas",
							"runner",
							"volador",
							"horda",
							"puzle",
							"torres",
							"carreras",
							"naves",
							"rompebloques",
							"bloques",
							"corredor",
							"serpiente",
							"memoria",
							"cajas",
