								"fantasia",
								"galactico",
								"fiesta",
								"mina",
								"dados",
								"modos"
							]
						},
						"description": "Para 'giros': la lista COMPLETA de giros que quedan en el juego (vacia = sin giros)."
					},
					"idiomas": {
						"type": "array",
						"maxItems": 28,
						"uniqueItems": true,
						"items": {
							"enum": [
