							"apilar",
							"topos",
							"saltos",
							"arena",
							"aldea",
							"ritmo",
							"clicker",
							"cartas",
							"rpg",
							"laberinto",
							"golf",
							"pesca",
							"fusion",
							"tubos",
							"burbujas",
							"imperio",
							"minas",
							"mazmorras",
							"granja",
							"mazo",
							"aventura",
							"cocina",
							"mahjong",
							"aparcamiento",
							"sopa",
							"sudoku",
							"nonograma",
							"cortar",
							"penaltis",
							"agujero",
							"ciudad",
							"canasta",
							"espiral",
							"buscaminas",
							"conecta",
							"damas",
							"billar",
							"solitario",
							"parchis",
							"caida",
							"bolos",
							"mundo",
							"royale",
							"cruzar",
							"arco",
							"cubos",
							"parkour",
							"tienda",
							"futbol",
							"terror",
							"conduccion",
							"zombis",
							"baloncesto",
							"tenis",
							"karts",
							"supervivencia",
							"triple",
							"tornillos",
							"hexas",
							"autobus",
							"duelo",
							"escalada",
							"tirachinas",
							"plantas",
							"palabra",
							"letras",
							"tycoon",
							"tragaperras",
							"reino",
							"multitud",
							"pedidos",
							"a_medida",
							"poder",
							"diferencias",
							"rompecabezas",
							"pintar",
							"cuchillos",
							"arquero",
							"flechas",
							"numeros",
							"cartas_locas",
							"domino",
							"bloques_colores",
							"tuberias",
							"ajedrez",
							"reversi",
							"buscar",
							"deslizar",
							"ahorcado",
							"flota",
							"simon",
							"estrategia",
							"autobatalla",
							"gemas",
							"coleccionables",
							"roguelike",
							"bombas",
							"artilleria",
							"comecocos",
							"cadena",
							"lucha",
							"sandia",
							"pinball",
							"metroidvania",
							"sigilo"
						],
						"description": "Para 'genero': runner (corre solo, tu saltas), volador (arcade de un toque), horda (vista desde arriba: sobrevives a oleadas con armas automaticas) o plataformas. puzle: combinar 3 en un tablero, torres (tower defense) o carreras (coches contra 3 rivales)."
					},
					"vista": {
						"enum": [
							"2d",
							"3d"
						],
						"description": "Para 'vista' (solo carreras): '3d' coches en 3D con camara detras; '2d' vista desde arriba."
					},
					"historia": {
						"type": "object",
						"additionalProperties": false,
						"required": [
							"niveles"
						],
						"description": "Op 'historia': los dialogos nuevos COMPLETOS (uno por nivel, en el orden de los niveles). Para quitarlos: activo false.",
						"properties": {
							"niveles": {
								"type": "array",
								"minItems": 1,
								"maxItems": 8,
								"items": {
									"type": "object",
									"additionalProperties": false,
									"required": [
										"intro"
									],
									"properties": {
										"intro": {
											"type": "array",
											"minItems": 0,
											"maxItems": 3,
											"items": {
												"type": "object",
												"additionalProperties": false,
												"required": [
													"quien",
													"texto"
												],
												"properties": {
													"quien": {
														"enum": [
															"heroe",
															"rival",
															"jefe",
															"narrador"
														],
														"description": "Quien habla: heroe, rival (el primer enemigo), jefe (solo si hay jefe) o narrador"
													},
													"texto": {
														"type": "string",
														"minLength": 2,
														"maxLength": 90
													}
												}
											}
										},
										"fin": {
											"type": "array",
											"maxItems": 2,
											"items": {
												"type": "object",
												"additionalProperties": false,
												"required": [
													"quien",
													"texto"
												],
												"properties": {
													"quien": {
														"enum": [
															"heroe",
															"rival",
															"jefe",
															"narrador"
														],
														"description": "Quien habla: heroe, rival (el primer enemigo), jefe (solo si hay jefe) o narrador"
													},
													"texto": {
														"type": "string",
														"minLength": 2,
														"maxLength": 90
													}
												}
											}
										}
									}
								}
							}
						}
					},
					"mapa": {
						"type": "array",
						"minItems": 3,
						"maxItems": 24,
						"items": {
							"type": "string",
							"minLength": 1,
							"maxLength": 400,
							"pattern": "^[A-Za-z0-9#^=.]+$"
						},
						"description": "Solo del editor manual de la app: el nivel 'indice' dibujado a mano, fila a fila. La IA nunca lo usa."
					},
					"preguntas": {
						"type": "array",
						"minItems": 15,
						"maxItems": 40,
						"description": "Op 'preguntas' (solo juegos de preguntas): la lista COMPLETA nueva, de facil a dificil.",
						"items": {
							"type": "object",
							"additionalProperties": false,
							"required": [
								"pregunta",
								"opciones",
								"correcta",
								"explicacion"
							],
							"properties": {
								"pregunta": {
									"type": "string",
									"minLength": 8,
									"maxLength": 110
								},
								"opciones": {
									"type": "array",
									"minItems": 4,
									"maxItems": 4,
									"items": {
										"type": "string",
										"minLength": 1,
										"maxLength": 40
									}
								},
								"correcta": {
									"type": "integer",
									"minimum": 0,
									"maximum": 3
								},
								"explicacion": {
									"type": "string",
									"minLength": 4,
									"maxLength": 110
								}
							}
						}
					},
					"tienda": {
						"type": "boolean"
					},
					"pase": {
						"type": "boolean"
					},
					"avisos": {
						"type": "boolean"
					},
					"nube": {
						"type": "boolean"
					},
					"online": {
						"type": "boolean"
					},
					"publico": {
						"enum": [
							"todos",
							"infantil"
						]
					},
					"ganadora": {
						"enum": [
							"a",
							"b"
						],
						"description": "Para 'prueba_ab': termina la prueba quedandose con la version A (la de siempre) o la B."
					},
					"referencia": {
						"enum": [
							"dibujo"
						],
						"description": "Solo para 'redibujar' el heroe con la imagen que ha subido y revisado el autor (la pone la app, nunca la IA)."
					},
					"giros": {
						"type": "array",
						"maxItems": 2,
						"uniqueItems": true,
						"items": {
							"enum": [
								"oscuridad",
								"espejo",
								"contrarreloj",
								"racha",
								"fantasma",
								"cola",
								"viento",
