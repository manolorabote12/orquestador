					"tuneles",
					"niebla",
					"barajar",
					"dorado",
					"invisibles",
					"monstruos",
					"apocalipsis",
					"invierno",
					"caza",
					"equipo",
					"criaturas",
					"survivor",
					"vampiros",
					"fantasia",
					"galactico",
					"fiesta",
					"mina",
					"dados"
				]
			},
			"description": "Giros opcionales encima del genero (ver GIROS DISPONIBLES): solo los de la lista de su genero."
		},
		"aventura": {
			"type": "array",
			"minItems": 1,
			"maxItems": 10,
			"description": "Solo genero aventura: un capitulo por nivel, en ESPANOL y apto para todos los publicos. La primera escena es el principio. Cada decision cambia valor, amistad u oro o da un objeto; algunas piden un minimo o un objeto. Tiene que haber un camino al FIN_BUENO empezando con todo a cero, ningun callejon sin salida y todas las escenas alcanzables.",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"titulo",
					"escenas",
					"finales"
				],
				"properties": {
					"titulo": {
						"type": "string",
						"maxLength": 40
					},
					"escenas": {
						"type": "array",
						"minItems": 4,
						"maxItems": 16,
						"items": {
							"type": "object",
							"additionalProperties": false,
							"required": [
								"id",
								"quien",
								"texto",
								"opciones"
							],
							"properties": {
								"id": {
									"type": "string",
									"maxLength": 12
								},
								"quien": {
									"type": "string",
									"enum": [
										"narrador",
										"heroe",
										"rival",
										"jefe",
										"aliado"
									]
								},
								"texto": {
									"type": "string",
									"minLength": 10,
									"maxLength": 240
								},
								"opciones": {
									"type": "array",
									"minItems": 1,
									"maxItems": 3,
									"items": {
										"type": "object",
										"additionalProperties": false,
										"required": [
											"texto",
											"va_a"
										],
										"properties": {
											"texto": {
												"type": "string",
												"minLength": 2,
												"maxLength": 60
											},
											"va_a": {
												"type": "string",
												"description": "id de otra escena del capitulo o FIN_BUENO, FIN_REGULAR o FIN_MALO"
											},
											"efecto": {
												"type": "object",
												"additionalProperties": false,
												"properties": {
													"valor": {
														"type": "integer",
														"minimum": -2,
														"maximum": 2
													},
													"amistad": {
														"type": "integer",
														"minimum": -2,
														"maximum": 2
													},
													"oro": {
														"type": "integer",
														"minimum": -10,
														"maximum": 10
													},
													"objeto": {
														"type": "string",
														"maxLength": 24
													}
												}
											},
											"requiere": {
												"type": "object",
												"additionalProperties": false,
												"properties": {
													"stat": {
														"type": "string",
														"enum": [
															"valor",
															"amistad",
															"oro"
														]
													},
													"min": {
														"type": "integer",
														"minimum": 1,
														"maximum": 10
