{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orquestador/diseno/v1",
	"title": "Diseno de juego (lo que decide la IA directora)",
	"description": "La IA solo decide contenido y gusto. Niveles, fisica y codigo los ponen piezas probadas.",
	"type": "object",
	"required": [
		"titulo",
		"lema",
		"resumen",
		"estilo",
		"heroe",
		"coleccionable",
		"escenario",
		"enemigos",
		"sensacion",
		"dificultad",
		"niveles",
		"sonido",
		"musica"
	],
	"additionalProperties": false,
	"properties": {
		"titulo": {
			"type": "string",
			"minLength": 2,
			"maxLength": 28,
			"description": "Nombre comercial con gancho, en espanol, original."
		},
		"lema": {
			"type": "string",
			"minLength": 4,
			"maxLength": 48,
			"description": "Frase corta bajo el titulo."
		},
		"resumen": {
			"type": "string",
			"minLength": 10,
			"maxLength": 300
		},
		"estilo": {
			"type": "object",
			"required": [
				"familia",
				"descripcion",
				"paleta"
			],
			"additionalProperties": false,
			"properties": {
				"familia": {
					"enum": [
						"pixel_art",
						"cartoon",
						"low_poly",
						"realista",
						"pintado"
					]
				},
				"descripcion": {
					"type": "string",
					"minLength": 10,
					"maxLength": 240,
					"description": "En INGLES: estilo visual para todos los prompts de imagen."
				},
				"paleta": {
					"type": "array",
					"minItems": 8,
					"maxItems": 16,
					"items": {
						"type": "string",
						"pattern": "^#[0-9a-fA-F]{6}$"
					}
				}
			}
		},
		"heroe": {
			"type": "object",
			"required": [
				"nombre",
				"descripcion"
			],
			"additionalProperties": false,
			"properties": {
				"nombre": {
					"type": "string",
					"minLength": 2,
					"maxLength": 24
				},
				"descripcion": {
					"type": "string",
					"minLength": 15,
					"maxLength": 240,
					"description": "En INGLES: aspecto fijo y reconocible."
				}
			}
		},
		"coleccionable": {
			"type": "object",
			"required": [
				"nombre",
				"nombre_plural",
				"descripcion"
			],
			"additionalProperties": false,
			"properties": {
				"nombre": {
					"type": "string",
					"minLength": 2,
					"maxLength": 20
				},
				"nombre_plural": {
					"type": "string",
					"minLength": 2,
					"maxLength": 20
				},
				"descripcion": {
					"type": "string",
					"minLength": 8,
					"maxLength": 200,
					"description": "En INGLES."
				}
			}
		},
		"escenario": {
			"type": "object",
			"required": [
				"descripcion"
			],
			"additionalProperties": false,
			"properties": {
				"descripcion": {
					"type": "string",
					"minLength": 8,
					"maxLength": 200,
					"description": "En INGLES: material del suelo, repetible."
				}
			}
		},
		"enemigos": {
			"type": "array",
			"minItems": 0,
			"maxItems": 3,
			"items": {
				"type": "object",
				"required": [
					"tipo",
					"nombre",
					"descripcion"
				],
				"additionalProperties": false,
				"properties": {
					"tipo": {
						"enum": [
							"walker",
							"spiky",
							"flyer"
						]
					},
					"nombre": {
						"type": "string",
						"minLength": 2,
						"maxLength": 24
					},
					"descripcion": {
						"type": "string",
						"minLength": 15,
						"maxLength": 220,
						"description": "En INGLES. spiky debe llevar pinchos visibles arriba; flyer debe tener alas o volar."
					}
				}
			}
		},
		"sensacion": {
			"enum": [
				"agil",
				"normal",
				"pesada"
			]
		},
		"dificultad": {
			"enum": [
				"facil",
				"normal",
				"dificil"
			]
		},
		"niveles": {
			"type": "array",
			"minItems": 3,
			"maxItems": 8,
			"items": {
				"type": "string",
				"minLength": 2,
				"maxLength": 28
			}
		},
		"sonido": {
			"enum": [
				"retro",
				"suave",
				"metalico"
			]
		},
		"musica": {
			"type": "object",
			"required": [
				"ambiente",
				"instrumentos",
				"tempo"
			],
			"additionalProperties": false,
			"properties": {
				"ambiente": {
					"type": "string",
					"maxLength": 160,
					"description": "En INGLES."
				},
				"instrumentos": {
					"type": "array",
					"minItems": 1,
					"maxItems": 6,
					"items": {
						"type": "string",
						"maxLength": 40
					}
				},
				"tempo": {
					"type": "integer",
					"minimum": 60,
					"maximum": 180
				}
			}
		},
		"extra": {
			"type": "object",
			"additionalProperties": false,
			"description": "Ajustes finos pedidos en el taller (no los rellena la directora al crear).",
			"properties": {
				"vidas": {
					"type": "integer",
					"minimum": 1,
					"maximum": 6
				},
				"velocidad": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"walker": {
							"type": "number",
							"minimum": 0.4,
							"maximum": 1.8
						},
						"spiky": {
							"type": "number",
							"minimum": 0.4,
							"maximum": 1.8
						},
						"flyer": {
							"type": "number",
							"minimum": 0.4,
							"maximum": 1.8
						}
					}
				}
			}
		},
		"poderes": {
			"type": "array",
			"maxItems": 5,
			"uniqueItems": true,
			"items": {
				"enum": [
					"corazon",
					"doble_salto",
					"iman",
					"velocidad",
					"estrella"
				]
			},
			"description": "Poderes que aparecen por los niveles (0 a 5)."
		},
		"disparo": {
			"type": "boolean",
			"description": "El heroe dispara (magia, laser, bolas...). Solo si la idea lo pide o encaja mucho."
		},
		"jefe": {
			"type": "object",
			"required": [
				"nombre",
				"descripcion"
			],
			"additionalProperties": false,
			"description": "Jefe final al acabar el ultimo nivel. Omitir para juegos de peques o muy relajados.",
			"properties": {
				"nombre": {
					"type": "string",
					"minLength": 2,
					"maxLength": 24
				},
				"descripcion": {
					"type": "string",
					"minLength": 15,
					"maxLength": 220,
					"description": "En INGLES: grande, imponente, distinto de los enemigos."
				}
			}
		},
		"extras": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"puntos_control": {
					"type": "boolean",
					"description": "Banderas de control a mitad de nivel (recomendado)."
				},
				"plataformas_moviles": {
					"type": "boolean",
					"description": "Huecos que se cruzan en plataformas que van y vienen."
				}
			}
		},
		"genero": {
			"type": "string",
			"enum": [
				"plataformas",
				"runner",
				"volador",
				"horda",
				"puzle",
				"torres",
				"carreras",
				"naves",
