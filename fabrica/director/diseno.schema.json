				"artilleria",
				"comecocos",
				"cadena",
				"lucha",
				"sandia",
				"pinball",
				"metroidvania",
				"sigilo"
			],
			"description": "plataformas (te mueves tu, jefe opcional), runner (corre solo, tu saltas), volador (arcade de un toque: tocas para volar entre columnas) u horda (vista desde arriba: sobrevives a oleadas con armas automaticas y eliges mejoras al subir de nivel). puzle: combinar 3 piezas iguales en un tablero con movimientos limitados, torres (tower defense: pones torres junto al camino para que los enemigos no lleguen a tu base) o carreras (coches vistos desde arriba: esquivas trafico y adelantas a 3 rivales)."
		},
		"voz": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"inicio",
				"victoria",
				"derrota"
			],
			"description": "Lo que grita el heroe (en ESPANOL, cortisimo, con su personalidad). Se dice en voz alta en el juego.",
			"properties": {
				"inicio": {
					"type": "string",
					"minLength": 2,
					"maxLength": 40
				},
				"victoria": {
					"type": "string",
					"minLength": 2,
					"maxLength": 40
				},
				"derrota": {
					"type": "string",
					"minLength": 2,
					"maxLength": 40
				}
			}
		},
		"vista": {
			"enum": [
				"2d",
				"3d"
			],
			"description": "Solo carreras: '3d' (coches low-poly en 3D con cámara detrás, por defecto) o '2d' (vista desde arriba, para ideas retro/pixel o 'vista desde arriba')."
		},
		"historia": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"niveles"
			],
			"description": "Dialogos cortos entre niveles en ESPANOL, para todos los publicos, con la personalidad de cada personaje. Uno por nivel, en el mismo orden que 'niveles'.",
			"properties": {
				"niveles": {
					"type": "array",
					"minItems": 1,
					"maxItems": 8,
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": [
							"intro"
						],
						"properties": {
							"intro": {
								"type": "array",
								"minItems": 0,
								"maxItems": 3,
								"items": {
									"type": "object",
									"additionalProperties": false,
									"required": [
										"quien",
										"texto"
									],
									"properties": {
										"quien": {
											"enum": [
												"heroe",
												"rival",
												"jefe",
												"narrador"
											],
											"description": "Quien habla: heroe, rival (el primer enemigo), jefe (solo si hay jefe) o narrador"
										},
										"texto": {
											"type": "string",
											"minLength": 2,
											"maxLength": 90
										}
									}
								}
							},
							"fin": {
								"type": "array",
								"maxItems": 2,
								"items": {
									"type": "object",
									"additionalProperties": false,
									"required": [
										"quien",
										"texto"
									],
									"properties": {
										"quien": {
											"enum": [
												"heroe",
												"rival",
												"jefe",
												"narrador"
											],
											"description": "Quien habla: heroe, rival (el primer enemigo), jefe (solo si hay jefe) o narrador"
										},
										"texto": {
											"type": "string",
											"minLength": 2,
											"maxLength": 90
										}
									}
								}
							}
						}
					}
				}
			}
		},
		"preguntas": {
			"type": "array",
			"minItems": 15,
			"maxItems": 40,
			"description": "Solo genero preguntas: las preguntas del juego en ESPANOL, ordenadas de facil a dificil, sobre el tema de la idea. Datos ciertos y comprobables, nada polemico.",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"pregunta",
					"opciones",
					"correcta",
					"explicacion"
				],
				"properties": {
					"pregunta": {
						"type": "string",
						"minLength": 8,
						"maxLength": 110
					},
					"opciones": {
						"type": "array",
						"minItems": 4,
						"maxItems": 4,
						"items": {
							"type": "string",
							"minLength": 1,
							"maxLength": 40
						}
					},
					"correcta": {
						"type": "integer",
						"minimum": 0,
						"maximum": 3
					},
					"explicacion": {
						"type": "string",
						"minLength": 4,
						"maxLength": 110
					}
				}
			}
		},
		"publico": {
			"enum": [
				"todos",
				"infantil"
			],
			"description": "Para quien es el juego. 'infantil' (menores de 13): sin compras, sin avisos, sin nada online abierto y anuncios para ninos."
		},
		"funciones": {
			"type": "object",
			"additionalProperties": false,
			"description": "Que lleva el juego publicado (las decide el autor en la app).",
			"properties": {
				"tienda": {
					"type": "boolean"
				},
				"pase": {
					"type": "boolean"
				},
				"avisos": {
					"type": "boolean"
				},
				"nube": {
					"type": "boolean"
				},
				"online": {
					"type": "boolean"
				}
			}
		},
		"plantilla": {
			"type": "string",
			"maxLength": 40,
			"description": "Plantilla de exito de la que sale (la pone la fabrica)."
		},
		"prueba_ab": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"nivel",
				"hacia",
				"id"
			],
			"description": "Prueba A/B de un nivel en marcha (la pone el taller, nunca la directora): la mitad de los jugadores juega la version B.",
			"properties": {
				"nivel": {
					"type": "integer",
					"minimum": 0
				},
				"hacia": {
					"enum": [
						"mas_facil",
						"mas_dificil",
						"distinto"
					]
				},
				"id": {
					"type": "string",
					"pattern": "^[a-z0-9_]{1,16}$"
				}
			}
		},
		"tutorial": {
			"type": "array",
			"maxItems": 6,
			"description": "Opcional (ver TUTORIAL): textos del tutorial de la primera partida con el tema de este juego, en el orden de los pasos de su genero.",
			"items": {
				"type": "string",
				"minLength": 4,
				"maxLength": 120
			}
		},
		"contenido": {
			"type": "object",
			"description": "Solo rpg, supervivencia, horda, zombis, imperio y karts (ver CONTENIDO PROPIO): heroes, habilidades y enemigos, u objetos, recursos, recetas y criaturas inventados para este juego. Son datos con margenes; la fabrica los prueba con bots."
		},
		"giros": {
			"type": "array",
			"maxItems": 2,
			"uniqueItems": true,
			"items": {
				"enum": [
					"oscuridad",
					"espejo",
					"contrarreloj",
					"racha",
					"fantasma",
					"cola",
					"viento",
					"tormenta",
